# Copy to .env and fill in. .env is gitignored and must never be committed.
# Only VITE_-prefixed vars are exposed to the client bundle. Never put the
# Supabase service_role key here — it is server-only (Edge Function env).

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional. Leave blank in local dev; Sentry stays a silent no-op when unset.
VITE_SENTRY_DSN=
